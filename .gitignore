node_modules
dist
.vite
*.log
# the server's ssh target and key path (tools/deploy-server.ts)
.env.server
# the online boards and accounts a local run of server/game/serve.mjs keeps,
# and the live server's copies `npm run fps backup` brings down (hashed passwords)
server/game/boards.json*
server/game/accounts.json*
server-backup/

# CC0 downloads (npm run assets, npm run models): fetched, not kept in git
public/tex/*
!public/tex/ATTRIBUTION.md
public/models/*
!public/models/heirlooms/
!public/models/mannequin/
# the bodies and the clothed figures: fetched by npm run characters, but kept,
# because what a figure IS now lives in them (src/game/mannequin.ts)
!public/models/body/
!public/models/body/hair/
!public/models/outfits/
public/audio/*
!public/audio/ATTRIBUTION.md
# the self-hosted HUD faces (npm run fonts): OFL, fetched not kept
public/fonts/*
!public/fonts/ATTRIBUTION.md
# the HUD's icons (npm run icons): Lucide ISC and game-icons.net CC BY 3.0
public/icons/*
!public/icons/ATTRIBUTION.md
shots/
