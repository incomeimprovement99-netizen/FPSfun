# Copy to .env.server (not in git) and fill in the VM (docs/SERVER_GUIDE.md).
#   RANGE_HOST    the ssh target: ubuntu@<the VM's public IP>
#   RANGE_KEY     the ssh private key file Oracle gave you for that VM
#   RANGE_DOMAIN  the DuckDNS name pointed at the VM
RANGE_HOST=ubuntu@1.2.3.4
RANGE_KEY=C:\Users\jwilb\Downloads\ssh-key-fpsfun.key
RANGE_DOMAIN=fpsfun.duckdns.org
